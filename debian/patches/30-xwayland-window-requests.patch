+static xcb_connection_t *xwm_connection(void) {
+	struct wlr_xwayland *wlr_xwayland = server.xwayland.wlr_xwayland;
+	return wlr_xwayland ? wlr_xwayland_get_xwm_connection(wlr_xwayland) : NULL;
+}
