Description: Fix \x escapes in config command arguments
 unescape_string() runs on the arguments of every config command. For
 \x it only accepted the decimal digits 0-9 and, when no digit followed,
 turned \x into a NUL byte that was then removed. So a workspace name
 that ends in \x, for example `wm.workspace.03.name: 3: three\x` read
 with set_from_resource, lost the \x in the key bindings, while i3 keeps
 it; `a\xyz` became `ayz`, and `\x4a` became the control character 0x04
 followed by `a`.
 .
 Read one or two hex digits after \x, and keep \x as it is when no hex
 digit follows, like other unknown escapes.
Author: rego-port-bot <339843353+rego-port-bot@users.noreply.github.com>
Forwarded: https://github.com/swaywm/sway/pull/9327
Last-Update: 2026-11-09
---
diff --git a/common/stringop.c b/common/stringop.c
--- a/common/stringop.c
+++ b/common/stringop.c
@@ -203,20 +203,19 @@ int unescape_string(char *string) {
 				string[i] = '\0';
 				break;
 			case 'x':
-				{
-					unsigned char c = 0;
-					if (string[i+1] >= '0' && string[i+1] <= '9') {
-						c = string[i+1] - '0';
-						if (string[i+2] >= '0' && string[i+2] <= '9') {
-							c *= 0x10;
-							c += string[i+2] - '0';
-							string[i+2] = '\0';
-						}
-						string[i+1] = '\0';
+				if (isxdigit((unsigned char)string[i+1])) {
+					char hex[3] = { string[i+1], '\0', '\0' };
+					string[i+1] = '\0';
+					if (isxdigit((unsigned char)string[i+2])) {
+						hex[1] = string[i+2];
+						string[i+2] = '\0';
 					}
 					string[i] = '\0';
-					string[i - 1] = c;
+					string[i - 1] = strtol(hex, NULL, 16);
+					i += strlen(hex);
 				}
+				// Without a hex digit, keep \x as it is
+				break;
 			}
 		}
 	}
