 	struct sway_seat *seat = keyboard->seat_device->sway_seat;
 	struct seat_config *sc = seat_get_config(seat);
 	if (!sc) {
@@ -898,6 +907,11 @@ static void sway_keyboard_group_add(struct sway_keyboard *keyboard) {
 		return;
 	}
 
+	if (sway_keyboard_a11y_enabled(keyboard)) {
