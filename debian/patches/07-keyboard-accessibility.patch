diff --git a/sway/input/keyboard_a11y.c b/sway/input/keyboard_a11y.c
new file mode 100644
index 0000000..4be3922
--- /dev/null
+++ b/sway/input/keyboard_a11y.c
@@ -0,0 +1,591 @@
+#include <limits.h>
+#include <stdlib.h>
+#include <time.h>
+#include <wlr/interfaces/wlr_keyboard.h>
+#include <wlr/types/wlr_keyboard.h>
+#include <wlr/types/wlr_seat.h>
+#include <xkbcommon/xkbcommon.h>
+#include <xkbcommon/xkbcommon-names.h>
+#include "sway/config.h"
+#include "sway/input/cursor.h"
+#include "sway/input/keyboard.h"
+#include "sway/input/seat.h"
+#include "sway/server.h"
+#include "log.h"
+
+// Interval between two pointer motions while a mouse key is held
+#define MOUSE_KEYS_INTERVAL 10 // ms
+
+struct sway_slow_key {
+	struct sway_keyboard *keyboard;
+	struct wlr_keyboard_key_event event;
+	struct wl_event_source *timer;
+	struct wl_list link; // sway_keyboard_a11y::slow_keys
+};
+
+static uint32_t get_current_time_msec(void) {
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static bool key_set_has(const struct sway_key_set *set, uint32_t keycode) {
+	for (size_t i = 0; i < set->len; ++i) {
+		if (set->keycodes[i] == keycode) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void key_set_add(struct sway_key_set *set, uint32_t keycode) {
+	if (set->len < SWAY_KEYBOARD_PRESSED_KEYS_CAP &&
+			!key_set_has(set, keycode)) {
+		set->keycodes[set->len++] = keycode;
+	}
+}
+
+static bool key_set_remove(struct sway_key_set *set, uint32_t keycode) {
+	for (size_t i = 0; i < set->len; ++i) {
+		if (set->keycodes[i] == keycode) {
+			set->keycodes[i] = set->keycodes[--set->len];
+			return true;
+		}
+	}
+	return false;
+}
+
+void sway_keyboard_a11y_get_config(const struct input_config *ic,
+		struct sway_keyboard_a11y_config *config) {
+	*config = (struct sway_keyboard_a11y_config){
+		.sticky_keys = false,
+		.sticky_keys_two_key_off = true,
+		.slow_keys = 0,
+		.bounce_keys = 0,
+		.mouse_keys = false,
+		.mouse_keys_init_delay = 300,
+		.mouse_keys_accel_time = 300,
+		.mouse_keys_max_speed = 1000,
+	};
+	if (!ic) {
+		return;
+	}
+	if (ic->sticky_keys != INT_MIN) {
+		config->sticky_keys = ic->sticky_keys;
+	}
+	if (ic->sticky_keys_two_key_off != INT_MIN) {
+		config->sticky_keys_two_key_off = ic->sticky_keys_two_key_off;
+	}
+	if (ic->slow_keys != INT_MIN) {
+		config->slow_keys = ic->slow_keys;
+	}
+	if (ic->bounce_keys != INT_MIN) {
+		config->bounce_keys = ic->bounce_keys;
+	}
+	if (ic->mouse_keys != INT_MIN) {
+		config->mouse_keys = ic->mouse_keys;
+	}
+	if (ic->mouse_keys_init_delay != INT_MIN) {
+		config->mouse_keys_init_delay = ic->mouse_keys_init_delay;
+	}
+	if (ic->mouse_keys_accel_time != INT_MIN) {
+		config->mouse_keys_accel_time = ic->mouse_keys_accel_time;
+	}
+	if (ic->mouse_keys_max_speed != INT_MIN) {
+		config->mouse_keys_max_speed = ic->mouse_keys_max_speed;
+	}
+}
+
+bool sway_keyboard_a11y_enabled(const struct sway_keyboard *keyboard) {
+	const struct sway_keyboard_a11y_config *config = &keyboard->a11y.config;
+	return config->sticky_keys || config->slow_keys > 0 ||
+		config->bounce_keys > 0 || config->mouse_keys;
+}
+
+/**
+ * Returns the modifier that sticky keys handles for this key: Shift, Control,
+ * Alt or Super, or 0 for any other key.
+ */
+static xkb_mod_mask_t sticky_keys_get_modifier(struct sway_keyboard *keyboard,
+		uint32_t keycode) {
+	struct xkb_keymap *keymap = keyboard->wlr->keymap;
+	if (!keymap) {
+		return 0;
+	}
+	xkb_keycode_t xkb_keycode = keycode + 8;
+	xkb_layout_index_t layout = xkb_state_key_get_layout(
+		keyboard->wlr->xkb_state, xkb_keycode);
+	if (layout == XKB_LAYOUT_INVALID) {
+		return 0;
+	}
+	const xkb_keysym_t *keysyms;
+	int len = xkb_keymap_key_get_syms_by_level(keymap, xkb_keycode, layout,
+		0, &keysyms);
+	for (int i = 0; i < len; ++i) {
+		const char *name = NULL;
+		switch (keysyms[i]) {
+		case XKB_KEY_Shift_L:
+		case XKB_KEY_Shift_R:
+			name = XKB_MOD_NAME_SHIFT;
+			break;
+		case XKB_KEY_Control_L:
+		case XKB_KEY_Control_R:
+			name = XKB_MOD_NAME_CTRL;
+			break;
+		case XKB_KEY_Alt_L:
+		case XKB_KEY_Alt_R:
+		case XKB_KEY_Meta_L:
+		case XKB_KEY_Meta_R:
+			name = XKB_MOD_NAME_ALT;
+			break;
+		case XKB_KEY_Super_L:
+		case XKB_KEY_Super_R:
+			name = XKB_MOD_NAME_LOGO;
+			break;
+		}
+		if (name) {
+			xkb_mod_index_t index = xkb_keymap_mod_get_index(keymap, name);
+			return index == XKB_MOD_INVALID ? 0 : (xkb_mod_mask_t)1 << index;
+		}
+	}
+	return 0;
+}
+
+static xkb_mod_mask_t sticky_keys_get_held(struct sway_keyboard *keyboard) {
+	xkb_mod_mask_t held = 0;
+	struct sway_key_set *delivered = &keyboard->a11y.delivered;
+	for (size_t i = 0; i < delivered->len; ++i) {
+		held |= sticky_keys_get_modifier(keyboard, delivered->keycodes[i]);
+	}
+	return held;
+}
+
+/**
+ * Update the latched and locked modifiers after a key has been delivered.
+ * `held` is the set of modifiers that were held before this key event.
+ */
+static void sticky_keys_handle_key(struct sway_keyboard *keyboard,
+		struct wlr_keyboard_key_event *event, xkb_mod_mask_t held) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	xkb_mod_mask_t modifier = sticky_keys_get_modifier(keyboard, event->keycode);
+
+	if (event->state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+		a11y->sticky_tap_keycode = 0;
+		if (!modifier) {
+			// The latched modifiers applied to this key press
+			a11y->sticky_latched = 0;
+		} else if (held) {
+			// Modifiers pressed together are ordinary modifiers
+			if (a11y->config.sticky_keys_two_key_off) {
+				a11y->sticky_latched = 0;
+				a11y->sticky_locked = 0;
+			}
+		} else {
+			a11y->sticky_tap_keycode = event->keycode;
+		}
+		return;
+	}
+
+	if (!modifier || a11y->sticky_tap_keycode != event->keycode) {
+		return;
+	}
+	a11y->sticky_tap_keycode = 0;
+
+	// A tap latches the modifier, a second one locks it, a third one unlocks
+	if (a11y->sticky_locked & modifier) {
+		a11y->sticky_locked &= ~modifier;
+	} else if (a11y->sticky_latched & modifier) {
+		a11y->sticky_latched &= ~modifier;
+		a11y->sticky_locked |= modifier;
+	} else {
+		a11y->sticky_latched |= modifier;
+	}
+}
+
+/**
+ * Notify the keyboard's modifiers, combining the xkb state with the sticky
+ * keys state.
+ */
+static void sync_modifiers(struct sway_keyboard *keyboard) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	struct wlr_keyboard *wlr = keyboard->wlr;
+	if (!wlr->xkb_state) {
+		return;
+	}
+
+	xkb_mod_mask_t depressed = xkb_state_serialize_mods(wlr->xkb_state,
+		XKB_STATE_MODS_DEPRESSED) & ~a11y->applied_depressed;
+	xkb_mod_mask_t latched = xkb_state_serialize_mods(wlr->xkb_state,
+		XKB_STATE_MODS_LATCHED) & ~a11y->applied_latched;
+	xkb_mod_mask_t locked = xkb_state_serialize_mods(wlr->xkb_state,
+		XKB_STATE_MODS_LOCKED) & ~a11y->applied_locked;
+	xkb_layout_index_t group = xkb_state_serialize_layout(wlr->xkb_state,
+		XKB_STATE_LAYOUT_EFFECTIVE);
+
+	xkb_mod_mask_t held = 0, sticky_latched = 0, sticky_locked = 0;
+	if (a11y->config.sticky_keys) {
+		// Virtual keyboards don't update the xkb state from key events.
+		// Report the modifier keys they hold as depressed, or the latched
+		// state would come without them.
+		held = sticky_keys_get_held(keyboard);
+		sticky_latched = a11y->sticky_latched;
+		sticky_locked = a11y->sticky_locked;
+	}
+	a11y->applied_depressed = held & ~depressed;
+	a11y->applied_latched = sticky_latched & ~latched;
+	a11y->applied_locked = sticky_locked & ~locked;
+	depressed |= held;
+	latched |= sticky_latched;
+	locked |= sticky_locked;
+
+	if (depressed != wlr->modifiers.depressed ||
+			latched != wlr->modifiers.latched ||
+			locked != wlr->modifiers.locked ||
+			group != wlr->modifiers.group) {
+		wlr_keyboard_notify_modifiers(wlr, depressed, latched, locked, group);
+	}
+}
+
+// Both keysyms of each keypad key, so that NumLock doesn't matter
+static const struct {
+	xkb_keysym_t keysyms[2];
+	int dx, dy;
+} mouse_keys_directions[] = {
+	{ { XKB_KEY_KP_1, XKB_KEY_KP_End }, -1, 1 },
+	{ { XKB_KEY_KP_2, XKB_KEY_KP_Down }, 0, 1 },
+	{ { XKB_KEY_KP_3, XKB_KEY_KP_Page_Down }, 1, 1 },
+	{ { XKB_KEY_KP_4, XKB_KEY_KP_Left }, -1, 0 },
+	{ { XKB_KEY_KP_6, XKB_KEY_KP_Right }, 1, 0 },
+	{ { XKB_KEY_KP_7, XKB_KEY_KP_Home }, -1, -1 },
+	{ { XKB_KEY_KP_8, XKB_KEY_KP_Up }, 0, -1 },
+	{ { XKB_KEY_KP_9, XKB_KEY_KP_Page_Up }, 1, -1 },
+};
+
+static bool mouse_keys_get_direction(struct sway_keyboard *keyboard,
+		uint32_t keycode, int *dx, int *dy) {
+	if (!keyboard->wlr->xkb_state) {
+		return false;
+	}
+	xkb_keysym_t keysym =
+		xkb_state_key_get_one_sym(keyboard->wlr->xkb_state, keycode + 8);
+	size_t len = sizeof(mouse_keys_directions) / sizeof(mouse_keys_directions[0]);
+	for (size_t i = 0; i < len; ++i) {
+		if (mouse_keys_directions[i].keysyms[0] == keysym ||
+				mouse_keys_directions[i].keysyms[1] == keysym) {
+			*dx = mouse_keys_directions[i].dx;
+			*dy = mouse_keys_directions[i].dy;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void mouse_keys_stop(struct sway_keyboard_a11y *a11y) {
+	a11y->mouse_keys_keycode = 0;
+	wl_event_source_timer_update(a11y->mouse_keys_timer, 0);
+}
+
+static int handle_mouse_keys_timer(void *data) {
+	struct sway_keyboard *keyboard = data;
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	const struct sway_keyboard_a11y_config *config = &a11y->config;
+
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	double t = (now.tv_sec - a11y->mouse_keys_start.tv_sec) * 1000.0 +
+		(now.tv_nsec - a11y->mouse_keys_start.tv_nsec) / 1000000.0 -
+		config->mouse_keys_init_delay;
+	if (t < 0) {
+		wl_event_source_timer_update(a11y->mouse_keys_timer, (int)-t + 1);
+		return 0;
+	}
+	wl_event_source_timer_update(a11y->mouse_keys_timer, MOUSE_KEYS_INTERVAL);
+
+	// The speed grows linearly to its maximum over the acceleration time
+	double max_speed = config->mouse_keys_max_speed / 1000.0; // px/ms
+	double accel_time = config->mouse_keys_accel_time;
+	double distance;
+	if (t < accel_time) {
+		distance = max_speed * t * t / (2 * accel_time);
+	} else {
+		distance = max_speed * (t - accel_time / 2);
+	}
+	double step = distance - a11y->mouse_keys_distance;
+	a11y->mouse_keys_distance = distance;
+	if (step <= 0) {
+		return 0;
+	}
+
+	struct sway_cursor *cursor = keyboard->seat_device->sway_seat->cursor;
+	double dx = a11y->mouse_keys_dx * step, dy = a11y->mouse_keys_dy * step;
+	cursor_handle_activity_from_device(cursor, &keyboard->wlr->base);
+	pointer_motion(cursor, get_current_time_msec(), &keyboard->wlr->base,
+		dx, dy, dx, dy);
+	wlr_seat_pointer_notify_frame(cursor->seat->wlr_seat);
+	return 0;
+}
+
+/**
+ * Returns true if the key moves the pointer and must not be delivered.
+ */
+static bool mouse_keys_handle_press(struct sway_keyboard *keyboard,
+		struct wlr_keyboard_key_event *event) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	int dx, dy;
+	if (!a11y->config.mouse_keys ||
+			!mouse_keys_get_direction(keyboard, event->keycode, &dx, &dy)) {
+		return false;
+	}
+
+	a11y->mouse_keys_keycode = event->keycode;
+	a11y->mouse_keys_dx = dx;
+	a11y->mouse_keys_dy = dy;
+	a11y->mouse_keys_distance = 0;
+	clock_gettime(CLOCK_MONOTONIC, &a11y->mouse_keys_start);
+	// A timeout of 0 would disarm the timer
+	wl_event_source_timer_update(a11y->mouse_keys_timer,
+		a11y->config.mouse_keys_init_delay > 0 ?
+		a11y->config.mouse_keys_init_delay : 1);
+	return true;
+}
+
+/**
+ * Deliver a key event that went through bounce keys and slow keys.
+ */
+static void deliver_key(struct sway_keyboard *keyboard,
+		struct wlr_keyboard_key_event *event) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	if (event->state == WL_KEYBOARD_KEY_STATE_PRESSED &&
+			mouse_keys_handle_press(keyboard, event)) {
+		key_set_add(&a11y->dropped, event->keycode);
+		return;
+	}
+
+	xkb_mod_mask_t held = 0;
+	if (a11y->config.sticky_keys) {
+		held = sticky_keys_get_held(keyboard);
+	}
+	if (event->state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+		key_set_add(&a11y->delivered, event->keycode);
+	} else {
+		key_set_remove(&a11y->delivered, event->keycode);
+	}
+
+	sway_keyboard_handle_key(keyboard, event);
+
+	// As wlroots does, update the xkb state after the key event
+	if (event->update_state && keyboard->wlr->xkb_state) {
+		xkb_state_update_key(keyboard->wlr->xkb_state, event->keycode + 8,
+			event->state == WL_KEYBOARD_KEY_STATE_PRESSED ?
+			XKB_KEY_DOWN : XKB_KEY_UP);
+	}
+	if (a11y->config.sticky_keys) {
+		sticky_keys_handle_key(keyboard, event, held);
+		sync_modifiers(keyboard);
+	}
+}
+
+static void slow_key_destroy(struct sway_slow_key *slow_key) {
+	wl_list_remove(&slow_key->link);
+	wl_event_source_remove(slow_key->timer);
+	free(slow_key);
+}
+
+static struct sway_slow_key *slow_key_find(struct sway_keyboard_a11y *a11y,
+		uint32_t keycode) {
+	struct sway_slow_key *slow_key;
+	wl_list_for_each(slow_key, &a11y->slow_keys, link) {
+		if (slow_key->event.keycode == keycode) {
+			return slow_key;
+		}
+	}
+	return NULL;
+}
+
+/**
+ * Deliver the press of a key that has been held for the slow keys delay.
+ */
+static void slow_key_accept(struct sway_slow_key *slow_key) {
+	struct sway_keyboard *keyboard = slow_key->keyboard;
+	struct wlr_keyboard_key_event event = slow_key->event;
+	event.time_msec += keyboard->a11y.config.slow_keys;
+	slow_key_destroy(slow_key);
+	deliver_key(keyboard, &event);
+}
+
+static int handle_slow_key_timer(void *data) {
+	struct sway_slow_key *slow_key = data;
+	struct sway_keyboard *keyboard = slow_key->keyboard;
+	slow_key_accept(slow_key);
+	// Outside of a key event, wlroots won't notify the new modifiers
+	sync_modifiers(keyboard);
+	return 0;
+}
+
+static void slow_keys_handle_press(struct sway_keyboard *keyboard,
+		struct wlr_keyboard_key_event *event) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	struct sway_slow_key *slow_key = calloc(1, sizeof(*slow_key));
+	if (!slow_key) {
+		sway_log(SWAY_ERROR, "Failed to allocate slow key");
+		return;
+	}
+	slow_key->keyboard = keyboard;
+	slow_key->event = *event;
+	slow_key->timer = wl_event_loop_add_timer(server.wl_event_loop,
+		handle_slow_key_timer, slow_key);
+	if (!slow_key->timer) {
+		sway_log(SWAY_ERROR, "Failed to create slow key timer");
+		free(slow_key);
+		return;
+	}
+	wl_list_insert(&a11y->slow_keys, &slow_key->link);
+
+	// Count the hold from the time of the press, unless that time isn't on
+	// our clock
+	int delay = a11y->config.slow_keys;
+	uint32_t age = get_current_time_msec() - event->time_msec;
+	if (age < (uint32_t)delay) {
+		delay -= age;
+	}
+	wl_event_source_timer_update(slow_key->timer, delay);
+}
+
+/**
+ * Returns true if the key was pressed during the bounce keys delay after its
+ * previous accepted press.
+ */
+static bool bounce_keys_reject(struct sway_keyboard_a11y *a11y,
+		struct wlr_keyboard_key_event *event) {
+	uint32_t delay = a11y->config.bounce_keys;
+	size_t oldest = 0;
+	for (size_t i = 0; i < a11y->bounce_keys_len; ++i) {
+		if (a11y->bounce_keys[i].keycode == event->keycode) {
+			if (event->time_msec - a11y->bounce_keys[i].time_msec < delay) {
+				return true;
+			}
+			a11y->bounce_keys[i].time_msec = event->time_msec;
+			return false;
+		}
+		if (event->time_msec - a11y->bounce_keys[i].time_msec >
+				event->time_msec - a11y->bounce_keys[oldest].time_msec) {
+			oldest = i;
+		}
+	}
+
+	size_t i = a11y->bounce_keys_len;
+	if (i < SWAY_KEYBOARD_PRESSED_KEYS_CAP) {
+		a11y->bounce_keys_len++;
+	} else {
+		i = oldest;
+	}
+	a11y->bounce_keys[i].keycode = event->keycode;
+	a11y->bounce_keys[i].time_msec = event->time_msec;
+	return false;
+}
+
+bool sway_keyboard_a11y_handle_key(struct sway_keyboard *keyboard,
+		struct wlr_keyboard_key_event *event) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	if (!sway_keyboard_a11y_enabled(keyboard)) {
+		return false;
+	}
+
+	// Keys are dropped or delivered later, so update the xkb state ourselves
+	// when the key is delivered rather than letting wlroots do it now
+	struct wlr_keyboard_key_event key = *event;
+	event->update_state = false;
+
+	seat_idle_notify_activity(keyboard->seat_device->sway_seat,
+		IDLE_SOURCE_KEYBOARD);
+
+	struct sway_slow_key *slow_key = slow_key_find(a11y, key.keycode);
+	if (key.state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+		// Ignore repeated presses of a key that is already down
+		if (slow_key || key_set_has(&a11y->delivered, key.keycode) ||
+				key_set_has(&a11y->dropped, key.keycode)) {
+			return true;
+		}
+		if (a11y->config.bounce_keys > 0 && bounce_keys_reject(a11y, &key)) {
+			key_set_add(&a11y->dropped, key.keycode);
+			return true;
+		}
+		if (a11y->config.slow_keys > 0) {
+			slow_keys_handle_press(keyboard, &key);
+			return true;
+		}
+	} else if (slow_key) {
+		uint32_t held = key.time_msec - slow_key->event.time_msec;
+		if (held < (uint32_t)a11y->config.slow_keys) {
+			slow_key_destroy(slow_key);
+			return true;
+		}
+		// The press was long enough, but its timer hasn't fired yet
+		slow_key_accept(slow_key);
+	}
+
+	if (key.state == WL_KEYBOARD_KEY_STATE_RELEASED &&
+			key_set_remove(&a11y->dropped, key.keycode)) {
+		if (key.keycode == a11y->mouse_keys_keycode) {
+			mouse_keys_stop(a11y);
+		}
+		return true;
+	}
+
+	deliver_key(keyboard, &key);
+	return true;
+}
+
+void sway_keyboard_a11y_init(struct sway_keyboard *keyboard) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	sway_keyboard_a11y_get_config(NULL, &a11y->config);
+	wl_list_init(&a11y->slow_keys);
+	a11y->mouse_keys_timer = wl_event_loop_add_timer(server.wl_event_loop,
+		handle_mouse_keys_timer, keyboard);
+}
+
+void sway_keyboard_a11y_configure(struct sway_keyboard *keyboard,
+		const struct input_config *ic) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	struct sway_keyboard_a11y_config old = a11y->config;
+	sway_keyboard_a11y_get_config(ic, &a11y->config);
+	const struct sway_keyboard_a11y_config *config = &a11y->config;
+
+	// Pending slow keys are dropped, along with their release
+	if (config->slow_keys == 0) {
+		struct sway_slow_key *slow_key, *tmp;
+		wl_list_for_each_safe(slow_key, tmp, &a11y->slow_keys, link) {
+			key_set_add(&a11y->dropped, slow_key->event.keycode);
+			slow_key_destroy(slow_key);
+		}
+	}
+	if (config->bounce_keys == 0) {
+		a11y->bounce_keys_len = 0;
+	}
+	if (!config->mouse_keys ||
+			config->mouse_keys_init_delay != old.mouse_keys_init_delay ||
+			config->mouse_keys_accel_time != old.mouse_keys_accel_time ||
+			config->mouse_keys_max_speed != old.mouse_keys_max_speed) {
+		mouse_keys_stop(a11y);
+	}
+	if (!sway_keyboard_a11y_enabled(keyboard)) {
+		// Key events bypass us from now on
+		a11y->delivered.len = 0;
+		a11y->dropped.len = 0;
+	}
+	if (config->sticky_keys != old.sticky_keys) {
+		a11y->sticky_tap_keycode = 0;
+		a11y->sticky_latched = 0;
+		a11y->sticky_locked = 0;
+		sync_modifiers(keyboard);
+	}
+}
+
+void sway_keyboard_a11y_finish(struct sway_keyboard *keyboard) {
+	struct sway_keyboard_a11y *a11y = &keyboard->a11y;
+	struct sway_slow_key *slow_key, *tmp;
+	wl_list_for_each_safe(slow_key, tmp, &a11y->slow_keys, link) {
+		slow_key_destroy(slow_key);
+	}
+	wl_event_source_remove(a11y->mouse_keys_timer);
+}
