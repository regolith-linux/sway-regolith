 	}
@@ -1104,6 +1118,8 @@ void sway_keyboard_configure(struct sway_keyboard *keyboard) {
 				keyboard->repeat_rate, keyboard->repeat_delay);
 	}
 
+	sway_keyboard_a11y_configure(keyboard, input_config);
+
 	if (!keyboard->seat_device->input_device->is_virtual) {
 		sway_keyboard_set_layout(keyboard, input_config);
 	}
@@ -1144,5 +1160,6 @@ void sway_keyboard_destroy(struct sway_keyboard *keyboard) {
 	wl_list_remove(&keyboard->keyboard_modifiers.link);
 	sway_keyboard_disarm_key_repeat(keyboard);
