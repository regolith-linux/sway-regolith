 #ifndef _SWAY_INPUT_KEYBOARD_H
 #define _SWAY_INPUT_KEYBOARD_H
 
+#include <time.h>
 #include "sway/input/seat.h"
 
 #define SWAY_KEYBOARD_PRESSED_KEYS_CAP 32
@@ -48,6 +49,60 @@ struct sway_shortcut_state {
 	uint32_t current_key;
 };
 
+/**
+ * Effective accessibility settings of a keyboard (see sway-input(5)).
+ */
+struct sway_keyboard_a11y_config {
+	bool sticky_keys;
+	bool sticky_keys_two_key_off;
+	int slow_keys; // ms, 0 disables
+	int bounce_keys; // ms, 0 disables
+	bool mouse_keys;
+	int mouse_keys_init_delay; // ms
+	int mouse_keys_accel_time; // ms
+	int mouse_keys_max_speed; // pixels per second
+};
+
+struct sway_key_set {
+	uint32_t keycodes[SWAY_KEYBOARD_PRESSED_KEYS_CAP];
+	size_t len;
+};
+
+struct sway_keyboard_a11y {
+	struct sway_keyboard_a11y_config config;
+
+	// Keys whose press was passed on, and keys whose press was dropped (their
+	// release is dropped too)
+	struct sway_key_set delivered;
+	struct sway_key_set dropped;
+
+	// Sticky keys
+	uint32_t sticky_tap_keycode; // modifier pressed on its own
+	xkb_mod_mask_t sticky_latched;
+	xkb_mod_mask_t sticky_locked;
+	// Modifiers added to the xkb state on top of its own ones
+	xkb_mod_mask_t applied_depressed;
+	xkb_mod_mask_t applied_latched;
+	xkb_mod_mask_t applied_locked;
+
+	// Slow keys
+	struct wl_list slow_keys; // sway_slow_key::link
+
+	// Bounce keys: time of the last accepted press of recent keys
+	struct {
+		uint32_t keycode;
+		uint32_t time_msec;
+	} bounce_keys[SWAY_KEYBOARD_PRESSED_KEYS_CAP];
+	size_t bounce_keys_len;
+
+	// Mouse keys
+	struct wl_event_source *mouse_keys_timer;
+	uint32_t mouse_keys_keycode; // direction key being held, or 0
+	int mouse_keys_dx, mouse_keys_dy;
+	struct timespec mouse_keys_start;
+	double mouse_keys_distance;
+};
+
 struct sway_keyboard {
 	struct sway_seat_device *seat_device;
 	struct wlr_keyboard *wlr;
