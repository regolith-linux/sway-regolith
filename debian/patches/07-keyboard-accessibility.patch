diff --git a/sway/commands/input/bounce_keys.c b/sway/commands/input/bounce_keys.c
new file mode 100644
index 0000000..861a524
--- /dev/null
+++ b/sway/commands/input/bounce_keys.c
@@ -0,0 +1,25 @@
+#include <limits.h>
+#include <stdlib.h>
+#include "sway/config.h"
+#include "sway/commands.h"
+
+struct cmd_results *input_cmd_bounce_keys(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "bounce_keys", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct input_config *ic = config->handler_context.input_config;
+	if (!ic) {
+		return cmd_results_new(CMD_FAILURE, "No input device defined.");
+	}
+
+	char *end;
+	long value = strtol(argv[0], &end, 10);
+	if (end == argv[0] || *end || value < 0 || value > INT_MAX) {
+		return cmd_results_new(CMD_INVALID,
+			"bounce_keys expects a non-negative number of milliseconds");
+	}
+	ic->bounce_keys = value;
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
