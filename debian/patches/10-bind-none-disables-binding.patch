 	list_t *split = split_string(argv[0], "+");
 	for (int i = 0; i < split->length; ++i) {
 		// Check for group
@@ -432,6 +433,14 @@ static struct cmd_results *cmd_bindsym_o
 			continue;
 		}
 
+		// The key "none" turns the whole combination into a no-op, so that
+		// a binding whose key comes from a variable can be switched off.
+		// The remaining keys are still checked, to report typos.
+		if (strcasecmp(split->items[i], "none") == 0) {
+			disabled = true;
+			continue;
+		}
+
 		// Identify the key and possibly change binding->type
 		uint32_t key_val = 0;
 		error = identify_key(split->items[i], binding->keys->length == 0,
@@ -454,6 +463,13 @@ static struct cmd_results *cmd_bindsym_o
 	}
 	list_free_items_and_destroy(split);
 
+	if (disabled) {
+		sway_log(SWAY_DEBUG, "%s - %s contains the key none, nothing to do",
+				bindtype, argv[0]);
+		free_sway_binding(binding);
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
