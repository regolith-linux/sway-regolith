+		xwayland_view->view.wlr_xwayland_surface->window_id,
+		xwayland->atoms[NET_WM_DESKTOP], XCB_ATOM_CARDINAL, 0, 1);
+	xcb_get_property_reply_t *reply =
+		xcb_get_property_reply(xcb_conn, cookie, NULL);
