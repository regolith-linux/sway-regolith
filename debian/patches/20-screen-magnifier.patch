+
+#define ZOOM_TOGGLE_DEFAULT 2.0
+
+/**
+ * The most recent factor above 1 used by each output, by output name, so that
+ * it outlives disconnecting the output.
+ */
+struct zoom_toggle_memory {
+	char *name;
+	double factor;
+};
+
+static list_t *toggle_memory = NULL;
+
+static struct zoom_toggle_memory *toggle_memory_find(const char *name) {
+	if (!toggle_memory) {
+		return NULL;
+	}
+	for (int i = 0; i < toggle_memory->length; i++) {
+		struct zoom_toggle_memory *memory = toggle_memory->items[i];
+		if (strcmp(memory->name, name) == 0) {
+			return memory;
+		}
+	}
+	return NULL;
+}
+
+static void toggle_memory_store(const char *name, double factor) {
+	struct zoom_toggle_memory *memory = toggle_memory_find(name);
+	if (!memory) {
+		memory = calloc(1, sizeof(*memory));
+		if (!memory) {
+			return;
+		}
+		memory->name = strdup(name);
+		if (!memory->name) {
+			free(memory);
+			return;
+		}
+		if (!toggle_memory) {
+			toggle_memory = create_list();
+		}
+		list_add(toggle_memory, memory);
+	}
+	memory->factor = factor;
+}
+
+double output_get_zoom_toggle_factor(struct sway_output *output) {
+	struct zoom_toggle_memory *memory =
+		toggle_memory_find(output->wlr_output->name);
+	return memory ? memory->factor : ZOOM_TOGGLE_DEFAULT;
+}
+
+static bool parse_number(const char *str, double *value) {
+	char *end;
+	errno = 0;
+	double number = strtod(str, &end);
+	if (end == str || *end != '\0' || errno != 0 || !isfinite(number)) {
+		return false;
+	}
+	*value = number;
+	return true;
+}
+
+bool zoom_parse_factor(const char *str, double *factor) {
+	double number;
+	if (!parse_number(str, &number) ||
+			number < ZOOM_FACTOR_MIN || number > ZOOM_FACTOR_MAX) {
+		return false;
+	}
+	*factor = number;
+	return true;
+}
+
+bool zoom_parse_step(const char *str, double *step) {
+	double number;
+	if (!parse_number(str, &number) || number <= 0) {
+		return false;
+	}
+	*step = number;
+	return true;
+}
+
+const char *zoom_mouse_tracking_to_string(enum zoom_mouse_tracking mode) {
+	switch (mode) {
+	case ZOOM_MOUSE_PROPORTIONAL:
+		return "proportional";
+	case ZOOM_MOUSE_CENTERED:
+		return "centered";
+	case ZOOM_MOUSE_PUSH:
+		return "push";
+	case ZOOM_MOUSE_NONE:
+		return "none";
+	}
+	return "unknown";
+}
+
+const char *zoom_focus_tracking_to_string(enum zoom_focus_tracking mode) {
+	switch (mode) {
+	case ZOOM_FOCUS_CENTERED:
+		return "centered";
+	case ZOOM_FOCUS_PUSH:
+		return "push";
+	case ZOOM_FOCUS_NONE:
+		return "none";
+	}
+	return "unknown";
+}
+
+static bool output_is_zoomed(struct sway_output *output) {
+	return output->enabled && output->zoom.factor > ZOOM_FACTOR_MIN &&
+		output->width > 0 && output->height > 0;
+}
+
+void output_get_zoom_view(struct sway_output *output, struct wlr_fbox *view) {
+	if (output_is_zoomed(output)) {
+		*view = output->zoom.view;
+	} else {
+		*view = (struct wlr_fbox){
+			.width = output->width,
+			.height = output->height,
+		};
+	}
+	view->x += output->lx;
+	view->y += output->ly;
+}
+
+/**
+ * Keep the shown rectangle inside the output.
+ */
+static void clamp_view(struct sway_output *output, struct wlr_fbox *view) {
+	view->x = fmin(fmax(view->x, 0), output->width - view->width);
+	view->y = fmin(fmax(view->y, 0), output->height - view->height);
+}
+
+static void zoom_damage(struct sway_output *output) {
+	wlr_damage_ring_add_whole(&output->scene_output->damage_ring);
+	wlr_output_update_needs_frame(output->wlr_output);
+}
+
+static void set_view(struct sway_output *output, const struct wlr_fbox *view) {
+	if (wlr_fbox_equal(&output->zoom.view, view)) {
+		return;
+	}
+	output->zoom.view = *view;
+	if (output->zoom.rendered || output_is_zoomed(output)) {
+		zoom_damage(output);
+	}
+}
+
+static void set_output_locks(struct sway_output *output, bool lock) {
+	if (lock == output->zoom.locked) {
+		return;
+	}
+	// The pointer has to be enlarged along with everything else, and the
+	// enlarged frame is always composited: a client buffer scanned out
+	// directly would show the layout unenlarged
+	wlr_output_lock_software_cursors(output->wlr_output, lock);
+	wlr_output_lock_attach_render(output->wlr_output, lock);
+	output->zoom.locked = lock;
+}
+
+static void update_output_locks(struct sway_output *output) {
+	set_output_locks(output, output_is_zoomed(output));
+}
+
+void output_zoom_destroy(struct sway_output *output) {
+	set_output_locks(output, false);
+	wlr_swapchain_destroy(output->zoom.swapchain);
+	output->zoom.swapchain = NULL;
+}
+
+/**
+ * Get the cursor position in output-local coordinates, if it is on the output.
+ */
+static bool cursor_on_output(struct sway_output *output,
+		struct sway_cursor *cursor, double *x, double *y) {
+	if (!cursor) {
+		return false;
+	}
+	struct wlr_output *wlr_output = wlr_output_layout_output_at(
+		root->output_layout, cursor->cursor->x, cursor->cursor->y);
+	if (!wlr_output || wlr_output != output->wlr_output) {
+		return false;
+	}
+	*x = cursor->cursor->x - output->lx;
+	*y = cursor->cursor->y - output->ly;
+	return true;
+}
+
+static struct sway_cursor *current_cursor(void) {
+	struct sway_seat *seat = input_manager_current_seat();
+	return seat ? seat->cursor : NULL;
+}
+
+/**
+ * Apply the pointer tracking mode once for a pointer on the output.
+ */
+static void follow_pointer(struct sway_output *output, double x, double y,
+		struct wlr_fbox *view) {
+	double factor = output->zoom.factor;
+	switch (config->zoom_mouse_tracking) {
+	case ZOOM_MOUSE_PROPORTIONAL:
+		view->x = x * (1 - 1 / factor);
+		view->y = y * (1 - 1 / factor);
+		break;
+	case ZOOM_MOUSE_CENTERED:
+		view->x = x - view->width / 2;
+		view->y = y - view->height / 2;
+		break;
+	case ZOOM_MOUSE_PUSH:
+		if (x < view->x) {
+			view->x = x;
+		} else if (x > view->x + view->width) {
+			view->x = x - view->width;
+		}
+		if (y < view->y) {
+			view->y = y;
+		} else if (y > view->y + view->height) {
+			view->y = y - view->height;
+		}
+		break;
+	case ZOOM_MOUSE_NONE:
+		return;
+	}
+	clamp_view(output, view);
+}
+
+void output_set_zoom(struct sway_output *output, double factor) {
+	if (factor == output->zoom.factor) {
+		return;
+	}
+	double previous = output->zoom.factor;
+	bool was_zoomed = output_is_zoomed(output);
+	output->zoom.factor = factor;
+	if (factor > ZOOM_FACTOR_MIN) {
+		toggle_memory_store(output->wlr_output->name, factor);
+	}
+	sway_log(SWAY_DEBUG, "Zoom of %s changed from %f to %f",
+		output->wlr_output->name, previous, factor);
+
+	if (!output->enabled || output->width <= 0 || output->height <= 0) {
+		// The shown rectangle is worked out once the output is enabled
+		output->zoom.view = (struct wlr_fbox){0};
+		return;
+	}
+
+	// Resize the shown rectangle around its centre, or around the pointer or
+	// the middle of the output when it was not enlarged
+	double x, y;
+	bool on_output = cursor_on_output(output, current_cursor(), &x, &y);
+	double center_x = output->width / 2.0, center_y = output->height / 2.0;
+	if (was_zoomed) {
+		center_x = output->zoom.view.x + output->zoom.view.width / 2;
+		center_y = output->zoom.view.y + output->zoom.view.height / 2;
+	} else if (on_output) {
+		center_x = x;
+		center_y = y;
+	}
+
+	struct wlr_fbox view = {
+		.width = output->width / factor,
+		.height = output->height / factor,
+	};
+	view.x = center_x - view.width / 2;
+	view.y = center_y - view.height / 2;
+	clamp_view(output, &view);
+	if (on_output) {
+		follow_pointer(output, x, y, &view);
+	}
+
+	output->zoom.view = view;
+	update_output_locks(output);
+	zoom_damage(output);
+}
+
+void output_update_zoom_geometry(struct sway_output *output) {
+	if (!output_is_zoomed(output)) {
+		update_output_locks(output);
+		return;
+	}
+
+	struct wlr_fbox view = output->zoom.view;
+	double width = output->width / output->zoom.factor;
+	double height = output->height / output->zoom.factor;
+	if (view.width != width || view.height != height) {
+		double center_x = output->width / 2.0, center_y = output->height / 2.0;
+		if (view.width > 0 && view.height > 0) {
+			center_x = view.x + view.width / 2;
+			center_y = view.y + view.height / 2;
+		}
+		view.width = width;
+		view.height = height;
+		view.x = center_x - width / 2;
+		view.y = center_y - height / 2;
+	}
+	clamp_view(output, &view);
+
+	output->zoom.view = view;
+	update_output_locks(output);
+	zoom_damage(output);
+}
+
+void zoom_handle_cursor_motion(struct sway_cursor *cursor) {
+	if (config->zoom_mouse_tracking == ZOOM_MOUSE_NONE) {
+		return;
+	}
+	struct wlr_output *wlr_output = wlr_output_layout_output_at(
+		root->output_layout, cursor->cursor->x, cursor->cursor->y);
+	if (!wlr_output) {
+		return;
+	}
+	struct sway_output *output = wlr_output->data;
+	if (!output || !output_is_zoomed(output)) {
+		return;
+	}
+
+	struct wlr_fbox view = output->zoom.view;
+	follow_pointer(output, cursor->cursor->x - output->lx,
+		cursor->cursor->y - output->ly, &view);
+	set_view(output, &view);
+}
+
+void zoom_handle_focus(struct sway_container *con) {
+	if (config->zoom_focus_tracking == ZOOM_FOCUS_NONE || !con->view) {
+		return;
+	}
+	struct sway_workspace *ws = con->pending.workspace;
+	struct sway_output *output = ws ? ws->output : NULL;
+	if (!output || !output_is_zoomed(output)) {
+		return;
+	}
+
+	struct wlr_fbox window = {
+		.x = con->pending.x - output->lx,
+		.y = con->pending.y - output->ly,
+		.width = con->pending.width,
+		.height = con->pending.height,
+	};
+	struct wlr_fbox view = output->zoom.view;
+	switch (config->zoom_focus_tracking) {
+	case ZOOM_FOCUS_CENTERED:
+		view.x = window.x + window.width / 2 - view.width / 2;
+		view.y = window.y + window.height / 2 - view.height / 2;
+		break;
+	case ZOOM_FOCUS_PUSH:
+		if (window.width > view.width || window.height > view.height) {
+			// Too big to show whole: show its top-left corner
+			view.x = window.x;
+			view.y = window.y;
+			break;
+		}
+		if (window.x < view.x) {
+			view.x = window.x;
+		} else if (window.x + window.width > view.x + view.width) {
+			view.x = window.x + window.width - view.width;
+		}
+		if (window.y < view.y) {
+			view.y = window.y;
+		} else if (window.y + window.height > view.y + view.height) {
+			view.y = window.y + window.height - view.height;
+		}
+		break;
+	case ZOOM_FOCUS_NONE:
+		return;
+	}
+	clamp_view(output, &view);
+	set_view(output, &view);
+}
+
+static bool output_state_changes_geometry(struct wlr_output *output,
+		const struct wlr_output_state *state) {
+	if ((state->committed & WLR_OUTPUT_STATE_ENABLED) && !state->enabled) {
+		return true;
+	}
+	if ((state->committed & WLR_OUTPUT_STATE_SCALE) &&
+			state->scale != output->scale) {
+		return true;
+	}
+	if ((state->committed & WLR_OUTPUT_STATE_TRANSFORM) &&
+			state->transform != output->transform) {
+		return true;
+	}
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		int width = 0, height = 0;
+		switch (state->mode_type) {
+		case WLR_OUTPUT_STATE_MODE_FIXED:
+			width = state->mode->width;
+			height = state->mode->height;
+			break;
+		case WLR_OUTPUT_STATE_MODE_CUSTOM:
+			width = state->custom_mode.width;
+			height = state->custom_mode.height;
+			break;
+		}
+		if (width != output->width || height != output->height) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/**
+ * Hide the cursors whose hot spot is outside the shown rectangle: they would
+ * be drawn outside the output. Returns the hidden cursors as a bit set.
+ */
+static uint64_t hide_cursors_outside_view(struct sway_output *output) {
+	struct wlr_output *wlr_output = output->wlr_output;
+	const struct wlr_fbox *view = &output->zoom.view;
+	uint64_t hidden = 0;
+	int i = 0;
+	struct wlr_output_cursor *cursor;
+	wl_list_for_each(cursor, &wlr_output->cursors, link) {
+		if (i >= 64) {
+			break;
+		}
+		double x = cursor->x / wlr_output->scale;
+		double y = cursor->y / wlr_output->scale;
+		if (cursor->enabled && (x < view->x || x >= view->x + view->width ||
+				y < view->y || y >= view->y + view->height)) {
+			cursor->enabled = false;
+			hidden |= (uint64_t)1 << i;
+		}
+		i++;
+	}
+	return hidden;
+}
+
+static void restore_cursors(struct sway_output *output, uint64_t hidden) {
+	int i = 0;
+	struct wlr_output_cursor *cursor;
+	wl_list_for_each(cursor, &output->wlr_output->cursors, link) {
+		if (i >= 64) {
+			break;
+		}
+		if (hidden & ((uint64_t)1 << i)) {
+			cursor->enabled = true;
+		}
+		i++;
+	}
+}
+
+static bool ensure_zoom_swapchain(struct sway_output *output,
+		struct wlr_swapchain *target) {
+	struct wlr_swapchain *swapchain = output->zoom.swapchain;
+	if (swapchain && swapchain->width == target->width &&
+			swapchain->height == target->height &&
+			swapchain->format.format == target->format.format) {
+		return true;
+	}
+	wlr_swapchain_destroy(swapchain);
+	output->zoom.swapchain = wlr_swapchain_create(output->wlr_output->allocator,
+		target->width, target->height, &target->format);
+	return output->zoom.swapchain != NULL;
+}
+
+/**
+ * Replace the frame in the state by the shown rectangle of it, enlarged to
+ * fill the output.
+ */
+static bool render_enlarged(struct sway_output *output,
+		struct wlr_output_state *state, struct wlr_swapchain *target) {
+	struct wlr_output *wlr_output = output->wlr_output;
+	struct wlr_renderer *renderer = wlr_output->renderer;
+
+	struct wlr_texture *texture =
+		wlr_texture_from_buffer(renderer, state->buffer);
+	if (!texture) {
+		return false;
+	}
+	struct wlr_buffer *buffer = wlr_swapchain_acquire(target);
+	if (!buffer) {
+		wlr_texture_destroy(texture);
+		return false;
+	}
+
+	// The shown rectangle in buffer coordinates
+	const struct wlr_fbox *view = &output->zoom.view;
+	struct wlr_fbox src = {
+		.x = view->x * wlr_output->scale,
+		.y = view->y * wlr_output->scale,
+		.width = view->width * wlr_output->scale,
+		.height = view->height * wlr_output->scale,
+	};
+	int width, height;
+	wlr_output_transformed_resolution(wlr_output, &width, &height);
+	wlr_fbox_transform(&src, &src,
+		wlr_output_transform_invert(wlr_output->transform), width, height);
+
+	// Sample whole source pixels, and place them so that the shown rectangle
+	// fills the buffer exactly; some renderers round fractional sources.
+	double scale_x = buffer->width / src.width;
+	double scale_y = buffer->height / src.height;
+	int x0 = fmax(floor(src.x), 0);
+	int y0 = fmax(floor(src.y), 0);
+	int x1 = fmin(ceil(src.x + src.width), texture->width);
+	int y1 = fmin(ceil(src.y + src.height), texture->height);
+	struct wlr_box dst_box = {
+		.x = round((x0 - src.x) * scale_x),
+		.y = round((y0 - src.y) * scale_y),
+	};
+	dst_box.width = round((x1 - src.x) * scale_x) - dst_box.x;
+	dst_box.height = round((y1 - src.y) * scale_y) - dst_box.y;
+
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(renderer, buffer, NULL);
+	if (!pass) {
+		wlr_texture_destroy(texture);
+		wlr_buffer_unlock(buffer);
+		return false;
+	}
+
+	pixman_region32_t clip;
+	pixman_region32_init_rect(&clip, 0, 0, buffer->width, buffer->height);
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+		.box = { .width = buffer->width, .height = buffer->height },
+		.color = { .r = 0, .g = 0, .b = 0, .a = 1 },
+	});
+	bool wait = state->committed & WLR_OUTPUT_STATE_WAIT_TIMELINE;
+	wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+		.texture = texture,
+		.src_box = {
+			.x = x0,
+			.y = y0,
+			.width = x1 - x0,
+			.height = y1 - y0,
+		},
+		.dst_box = dst_box,
+		.clip = &clip,
+		.filter_mode = WLR_SCALE_FILTER_NEAREST,
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+		.wait_timeline = wait ? state->wait_timeline : NULL,
+		.wait_point = wait ? state->wait_point : 0,
+	});
+	pixman_region32_fini(&clip);
+
+	bool ok = wlr_render_pass_submit(pass);
+	wlr_texture_destroy(texture);
+	if (!ok) {
+		wlr_buffer_unlock(buffer);
+		return false;
+	}
+
+	// The enlarged frame was rendered after waiting for the scene
+	state->committed &= ~WLR_OUTPUT_STATE_WAIT_TIMELINE;
+	wlr_output_state_set_buffer(state, buffer);
+	wlr_buffer_unlock(buffer);
+
+	pixman_region32_t damage;
+	pixman_region32_init_rect(&damage, 0, 0, buffer->width, buffer->height);
+	wlr_output_state_set_damage(state, &damage);
+	pixman_region32_fini(&damage);
+	return true;
+}
+
+static void set_whole_damage(struct sway_output *output,
+		struct wlr_output_state *state) {
+	pixman_region32_t damage;
+	pixman_region32_init_rect(&damage, 0, 0,
+		output->wlr_output->width, output->wlr_output->height);
+	wlr_output_state_set_damage(state, &damage);
+	pixman_region32_fini(&damage);
+}
+
+bool output_build_state(struct sway_output *output,
+		struct wlr_output_state *state,
+		const struct wlr_scene_output_state_options *options) {
+	struct wlr_output *wlr_output = output->wlr_output;
+	struct wlr_scene_output *scene_output = output->scene_output;
+
+	if (!output_is_zoomed(output) ||
+			output_state_changes_geometry(wlr_output, state)) {
+		bool was_rendered = output->zoom.rendered;
+		output->zoom.rendered = false;
+		if (!output_is_zoomed(output) && output->zoom.swapchain) {
+			wlr_swapchain_destroy(output->zoom.swapchain);
+			output->zoom.swapchain = NULL;
+		}
+		if (!wlr_scene_output_build_state(scene_output, state, options)) {
+			return false;
+		}
+		if (was_rendered && (state->committed & WLR_OUTPUT_STATE_BUFFER)) {
+			// Replace the whole enlarged picture
+			set_whole_damage(output, state);
+		}
+		return true;
+	}
+
+	struct wlr_swapchain *target = options ? options->swapchain : NULL;
+	if (!target) {
+		if (!wlr_output_configure_primary_swapchain(wlr_output, state,
+				&wlr_output->swapchain)) {
+			return false;
+		}
+		target = wlr_output->swapchain;
+	}
+	if (!ensure_zoom_swapchain(output, target)) {
+		sway_log(SWAY_ERROR, "Unable to allocate the zoom buffers of %s",
+			wlr_output->name);
+		return false;
+	}
+
+	struct wlr_scene_output_state_options scene_options = {0};
+	if (options) {
+		scene_options = *options;
+	}
+	scene_options.swapchain = output->zoom.swapchain;
+
+	uint64_t hidden = hide_cursors_outside_view(output);
+	if (hidden != output->zoom.hidden_cursors || !output->zoom.rendered) {
+		wlr_damage_ring_add_whole(&scene_output->damage_ring);
+	}
+	output->zoom.hidden_cursors = hidden;
+	bool ok = wlr_scene_output_build_state(scene_output, state, &scene_options);
+	restore_cursors(output, hidden);
+	if (!ok) {
+		return false;
+	}
+	if (!(state->committed & WLR_OUTPUT_STATE_BUFFER)) {
+		return true;
+	}
+
+	if (!render_enlarged(output, state, target)) {
+		sway_log(SWAY_ERROR, "Unable to render the enlarged frame of %s",
+			wlr_output->name);
+		// Make sure the next frame is drawn in full
+		wlr_damage_ring_add_whole(&scene_output->damage_ring);
+		output->zoom.rendered = false;
+		return false;
+	}
+	output->zoom.rendered = true;
+	return true;
+}
