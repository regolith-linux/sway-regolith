diff --git a/sway/commands/output/zoom.c b/sway/commands/output/zoom.c
new file mode 100644
--- /dev/null
+++ b/sway/commands/output/zoom.c
@@ -0,0 +1,27 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/output.h"
+
+struct cmd_results *output_cmd_zoom(int argc, char **argv) {
+	if (!config->handler_context.output_config) {
+		return cmd_results_new(CMD_FAILURE, "Missing output config");
+	}
+	if (argc == 0) {
+		return cmd_results_new(CMD_INVALID, "Missing zoom argument");
+	}
+
+	double factor;
+	if (strcasecmp(argv[0], "off") == 0) {
+		factor = 1;
+	} else if (!zoom_parse_factor(argv[0], &factor)) {
+		return cmd_results_new(CMD_INVALID,
+			"Invalid zoom factor '%s': expected a number from %g to %g or 'off'",
+			argv[0], ZOOM_FACTOR_MIN, ZOOM_FACTOR_MAX);
+	}
+	config->handler_context.output_config->zoom = factor;
+
+	config->handler_context.leftovers.argc = argc - 1;
+	config->handler_context.leftovers.argv = argv + 1;
+	return NULL;
+}
