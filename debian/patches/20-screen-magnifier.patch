diff --git a/sway/commands/zoom.c b/sway/commands/zoom.c
new file mode 100644
--- /dev/null
+++ b/sway/commands/zoom.c
@@ -0,0 +1,119 @@
+#include <math.h>
+#include <strings.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/input/cursor.h"
+#include "sway/input/input-manager.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/root.h"
+
+static const char expected_syntax[] =
+	"Expected 'zoom in|out [<step>]', 'zoom set <factor>' or 'zoom off|toggle'";
+
+enum zoom_action {
+	ZOOM_IN,
+	ZOOM_OUT,
+	ZOOM_SET,
+	ZOOM_OFF,
+	ZOOM_TOGGLE,
+};
+
+struct cmd_results *cmd_zoom(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "zoom", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	enum zoom_action action;
+	double value = 1;
+	if (strcasecmp(argv[0], "in") == 0 || strcasecmp(argv[0], "out") == 0) {
+		action = strcasecmp(argv[0], "in") == 0 ? ZOOM_IN : ZOOM_OUT;
+		if (argc > 2) {
+			return cmd_results_new(CMD_INVALID, "%s", expected_syntax);
+		}
+		if (argc == 2 && !zoom_parse_step(argv[1], &value)) {
+			return cmd_results_new(CMD_INVALID,
+				"Invalid zoom step '%s': expected a positive number", argv[1]);
+		}
+	} else if (strcasecmp(argv[0], "set") == 0) {
+		action = ZOOM_SET;
+		if (argc != 2) {
+			return cmd_results_new(CMD_INVALID, "%s", expected_syntax);
+		}
+		if (strcasecmp(argv[1], "off") != 0 && !zoom_parse_factor(argv[1], &value)) {
+			return cmd_results_new(CMD_INVALID,
+				"Invalid zoom factor '%s': expected a number from %g to %g",
+				argv[1], ZOOM_FACTOR_MIN, ZOOM_FACTOR_MAX);
+		}
+	} else if (strcasecmp(argv[0], "off") == 0 && argc == 1) {
+		action = ZOOM_OFF;
+	} else if (strcasecmp(argv[0], "toggle") == 0 && argc == 1) {
+		action = ZOOM_TOGGLE;
+	} else {
+		return cmd_results_new(CMD_INVALID, "%s", expected_syntax);
+	}
+
+	if (config->validating) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	if (!config->active) {
+		// The output under the pointer is only known once outputs exist
+		return cmd_results_new(CMD_DEFER, NULL);
+	}
+
+	struct sway_seat *seat = config->handler_context.seat;
+	if (!seat) {
+		seat = input_manager_current_seat();
+	}
+	struct wlr_cursor *cursor = seat->cursor->cursor;
+	struct wlr_output *wlr_output = wlr_output_layout_output_at(
+		root->output_layout, cursor->x, cursor->y);
+	if (!wlr_output) {
+		return cmd_results_new(CMD_FAILURE, "There is no output under the pointer");
+	}
+	struct sway_output *output = wlr_output->data;
+
+	// Start from the stored factor, which may not be applied yet
+	double factor = output->zoom.factor;
+	struct output_config *current = find_output_config(output);
+	if (current && current->zoom != -1) {
+		factor = current->zoom;
+	}
+	free_output_config(current);
+
+	switch (action) {
+	case ZOOM_IN:
+		factor = fmin(factor + value, ZOOM_FACTOR_MAX);
+		break;
+	case ZOOM_OUT:
+		factor = fmax(factor - value, ZOOM_FACTOR_MIN);
+		break;
+	case ZOOM_SET:
+		factor = value;
+		break;
+	case ZOOM_OFF:
+		factor = ZOOM_FACTOR_MIN;
+		break;
+	case ZOOM_TOGGLE:
+		factor = factor > ZOOM_FACTOR_MIN ?
+			ZOOM_FACTOR_MIN : output_get_zoom_toggle_factor(output);
+		break;
+	}
+
+	// Behave like "output <name> zoom <factor>"
+	struct output_config *oc = new_output_config(wlr_output->name);
+	if (!oc) {
+		return cmd_results_new(CMD_FAILURE, "Unable to allocate output config");
+	}
+	oc->zoom = factor;
+	store_output_config(oc);
+
+	if (!config->reading) {
+		output_set_zoom(output, factor);
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
