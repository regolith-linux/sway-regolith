 	} else if (strcmp(interface, xdg_wm_base_interface.name) == 0) {
 		bar->wm_base = wl_registry_bind(registry, name, &xdg_wm_base_interface, 1);
+		xdg_wm_base_add_listener(bar->wm_base, &wm_base_listener, NULL);
 	}
 }
 
