+static void add_status_line_hotspot(struct swaybar_output *output, double x) {
+	struct status_line *status = output->bar->status;
+	if (!status || status->protocol != PROTOCOL_I3BAR ||
+			!status->click_events || x >= output->width) {
+		return;
+	}
+	// While click events are enabled, the status line owns the region from
+	// its first block to the end of the bar, across the full bar height
+	struct swaybar_hotspot *hotspot = calloc(1, sizeof(struct swaybar_hotspot));
+	hotspot->x = x;
+	hotspot->y = 0;
+	hotspot->width = output->width - hotspot->x;
+	hotspot->height = output->height;
+	hotspot->callback = status_line_hotspot_callback;
+	// Appended so that blocks, tray items and workspace buttons are matched
+	// before it
+	wl_list_insert(output->hotspots.prev, &hotspot->link);
