+struct origin_probe {
+	bool configured, dismissed;
+	int32_t x, y;
+};
+
+static void origin_probe_configure(void *data, struct xdg_popup *popup,
+		int32_t x, int32_t y, int32_t width, int32_t height) {
+	struct origin_probe *probe = data;
+	probe->x = x;
+	probe->y = y;
+	probe->configured = true;
+}
+
+static void origin_probe_done(void *data, struct xdg_popup *popup) {
+	struct origin_probe *probe = data;
+	probe->dismissed = true;
+}
+
+static const struct xdg_popup_listener origin_probe_listener = {
+	.configure = origin_probe_configure,
+	.popup_done = origin_probe_done,
+};
+
+/*
+ * Layer surfaces are never told where they were placed, and the configured
+ * gaps do not say it either: other layer surfaces reserving space on the same
+ * edge (more bars, panels) push the bar further in. The compositor does
+ * reveal it through a popup, though. A throwaway popup of the bar surface is
+ * asked for far beyond the output's top-left corner, allowed to slide; the
+ * compositor slides it back to that corner and reports its position relative
+ * to the bar surface, which is minus the bar's origin on the output. The
+ * popup never gets a buffer, so it is never shown.
+ */
+static bool query_surface_origin(struct swaybar_output *output,
+		int32_t *x, int32_t *y) {
+	struct swaybar *bar = output->bar;
+	if (!bar->wm_base || !output->layer_surface) {
+		return false;
+	}
+	// Further than any output can be from its bar
+	const int32_t distance = 1 << 24;
+
+	// The probe has a queue of its own, so that waiting for its reply does
+	// not dispatch the bar's other events from within an input handler
+	struct wl_event_queue *queue = wl_display_create_queue(bar->display);
+	struct wl_compositor *compositor = wl_proxy_create_wrapper(bar->compositor);
+	struct xdg_wm_base *wm_base = wl_proxy_create_wrapper(bar->wm_base);
+	wl_proxy_set_queue((struct wl_proxy *)compositor, queue);
+	wl_proxy_set_queue((struct wl_proxy *)wm_base, queue);
+
+	struct xdg_positioner *positioner = xdg_wm_base_create_positioner(wm_base);
+	xdg_positioner_set_size(positioner, 1, 1);
+	xdg_positioner_set_anchor_rect(positioner, 0, 0, 1, 1);
+	xdg_positioner_set_anchor(positioner, XDG_POSITIONER_ANCHOR_TOP_LEFT);
+	xdg_positioner_set_gravity(positioner, XDG_POSITIONER_GRAVITY_TOP_LEFT);
+	xdg_positioner_set_offset(positioner, -distance, -distance);
+	xdg_positioner_set_constraint_adjustment(positioner,
+			XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_X |
+			XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_Y);
+
+	struct wl_surface *surface = wl_compositor_create_surface(compositor);
+	struct xdg_surface *xdg_surface =
+		xdg_wm_base_get_xdg_surface(wm_base, surface);
+	struct xdg_popup *popup = xdg_surface_get_popup(xdg_surface, NULL,
+			positioner);
+	struct origin_probe probe = {0};
+	xdg_popup_add_listener(popup, &origin_probe_listener, &probe);
+	zwlr_layer_surface_v1_get_popup(output->layer_surface, popup);
+	wl_surface_commit(surface);
+
+	// The configure event is sent once the compositor goes idle, which can be
+	// after the reply to the first roundtrip
+	for (int i = 0; i < 4 && !probe.configured && !probe.dismissed; i++) {
+		if (wl_display_roundtrip_queue(bar->display, queue) == -1) {
+			break;
+		}
+	}
+
+	xdg_popup_destroy(popup);
+	xdg_surface_destroy(xdg_surface);
+	wl_surface_destroy(surface);
+	xdg_positioner_destroy(positioner);
+	wl_proxy_wrapper_destroy(wm_base);
+	wl_proxy_wrapper_destroy(compositor);
+	wl_event_queue_destroy(queue);
+
+	if (!probe.configured || probe.dismissed) {
+		sway_log(SWAY_DEBUG, "Unable to find the bar surface's origin on %s",
+				output->name);
+		return false;
+	}
+	*x = -probe.x;
+	*y = -probe.y;
+	return true;
+}
+
+void bar_surface_origin(struct swaybar_output *output, double *x, double *y) {
+	int32_t origin_x, origin_y;
+	if (query_surface_origin(output, &origin_x, &origin_y)) {
+		*x = origin_x;
+		*y = origin_y;
+		return;
+	}
+	// Without an answer, assume no other surface reserves space on the bar's
+	// edge, so that the bar sits at its gaps
+	struct swaybar_config *config = output->bar->config;
+	*x = config->gaps.left;
+	*y = config->gaps.top;
+	if ((config->position & ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM) &&
+			!(config->position & ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP)) {
+		*y = (double)output->output_height - output->height
+			- config->gaps.bottom;
+	}
+}
