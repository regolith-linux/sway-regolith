+	wlr_output_lock_software_cursors(source->wlr_output, false);
+	wl_list_remove(&output->mirror.source_commit.link);
+	mirror_clear_frame(output);
+	output->mirror_source = NULL;
+	output->mirror.needs_frame = false;
