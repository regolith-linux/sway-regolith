+/**
+ * getopt_long accepts any unambiguous prefix of a long option. Checks whether
+ * the argument that named the option just parsed spells out its full name,
+ * alone or followed by '='. The argument is stored in given.
+ */
+static bool long_option_is_exact(char **argv, const char *name,
+		const char **given) {
+	// The value is either joined to the option or the following argument
+	const char *arg = optarg == argv[optind - 1] ?
+		argv[optind - 2] : argv[optind - 1];
+	*given = arg;
+	size_t len = strlen(name);
+	return strncmp(arg, "--", 2) == 0 && strncmp(arg + 2, name, len) == 0
+		&& (arg[len + 2] == '\0' || arg[len + 2] == '=');
+}
