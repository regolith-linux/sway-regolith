+static void render_focus_frame(cairo_t *cairo, struct swaynag *swaynag) {
+	struct swaynag_button *button =
+		swaynag->buttons->items[swaynag->focused_button];
+	uint32_t color = swaynag->type->focus_border ?
+		swaynag->type->focus_border : swaynag->type->button_text;
+
+	// The frame replaces the button border. Without a border, it is drawn
+	// one pixel wide inside the button background instead.
+	int border = swaynag->type->button_border_thickness;
+	if (border < 0) {
+		border = 0;
+	}
+	int thickness = border > 0 ? border : 1;
+	int x = button->x - border;
+	int y = button->y - border;
+	int width = button->width + border * 2;
+	int height = button->height + border * 2;
+
+	cairo_set_source_u32(cairo, color);
+	cairo_rectangle(cairo, x, y, width, thickness);
+	cairo_rectangle(cairo, x, y + height - thickness, width, thickness);
+	cairo_rectangle(cairo, x, y + thickness,
+			thickness, height - thickness * 2);
+	cairo_rectangle(cairo, x + width - thickness, y + thickness,
+			thickness, height - thickness * 2);
+	cairo_fill(cairo);
+}
