+static void wl_keyboard_key(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t serial, uint32_t time, uint32_t key, uint32_t key_state) {
+	struct swaynag_seat *seat = data;
+	struct swaynag *swaynag = seat->swaynag;
+	struct swaynag_keyboard *keyboard = &seat->keyboard;
+
+	if (key_state != WL_KEYBOARD_KEY_STATE_PRESSED) {
+		if (swaynag->repeat_seat == seat && swaynag->repeat_key == key) {
+			stop_repeat(swaynag);
+		}
+		return;
+	}
+	stop_repeat(swaynag);
+	if (!keyboard->state) {
+		return;
+	}
+
+	// Evdev scancodes are offset by 8 in xkb keycodes
+	xkb_keysym_t sym = xkb_state_key_get_one_sym(keyboard->state, key + 8);
+	if (keyboard_mod_active(keyboard, XKB_MOD_NAME_CTRL)
+			|| keyboard_mod_active(keyboard, XKB_MOD_NAME_ALT)
+			|| keyboard_mod_active(keyboard, XKB_MOD_NAME_LOGO)) {
+		return;
+	}
+	if (keyboard_mod_active(keyboard, XKB_MOD_NAME_SHIFT)) {
+		// Shift only moves focus backwards with Tab, and does not change
+		// activation. Any other shifted key does nothing.
+		switch (sym) {
+		case XKB_KEY_Tab:
+			sym = XKB_KEY_ISO_Left_Tab;
+			break;
+		case XKB_KEY_ISO_Left_Tab:
+		case XKB_KEY_Return:
+		case XKB_KEY_KP_Enter:
+		case XKB_KEY_space:
+			break;
+		default:
+			return;
+		}
+	}
+
+	// Arm the repeat first: rendering does a roundtrip, which may dispatch
+	// the release of this key before handle_keysym returns
+	if (keysym_repeats(sym)) {
+		start_repeat(swaynag, seat, key, sym);
+	}
+	handle_keysym(swaynag, sym);
+}
