+static void wl_keyboard_keymap(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t format, int32_t fd, uint32_t size) {
+	struct swaynag_seat *seat = data;
+	struct swaynag_keyboard *keyboard = &seat->keyboard;
+
+	if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1) {
+		close(fd);
+		sway_log(SWAY_ERROR, "Unsupported keymap format %d", format);
+		return;
+	}
+
+	char *map_shm = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+	close(fd);
+	if (map_shm == MAP_FAILED) {
+		sway_log_errno(SWAY_ERROR, "Unable to map the keymap");
+		return;
+	}
+	struct xkb_keymap *keymap = xkb_keymap_new_from_buffer(
+			seat->swaynag->xkb_context, map_shm, strnlen(map_shm, size),
+			XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	munmap(map_shm, size);
+	if (!keymap) {
+		sway_log(SWAY_ERROR, "Failed to compile the keymap");
+		return;
+	}
+	struct xkb_state *state = xkb_state_new(keymap);
+	if (!state) {
+		sway_log(SWAY_ERROR, "Failed to create the keyboard state");
+		xkb_keymap_unref(keymap);
+		return;
+	}
+
+	xkb_state_unref(keyboard->state);
+	xkb_keymap_unref(keyboard->keymap);
+	keyboard->keymap = keymap;
+	keyboard->state = state;
+}
