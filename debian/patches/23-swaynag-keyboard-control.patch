+static void handle_repeat_timer(struct swaynag *swaynag) {
+	uint64_t expirations;
+	if (read(swaynag->repeat_timer, &expirations, sizeof(expirations))
+			!= sizeof(expirations)) {
+		// Disarmed after poll returned, or spurious
+		return;
+	}
+	for (uint64_t i = 0; i < expirations && swaynag->run_display
+			&& swaynag->repeat_seat; i++) {
