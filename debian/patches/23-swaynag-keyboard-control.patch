+static void stop_repeat(struct swaynag *swaynag) {
+	swaynag->repeat_seat = NULL;
+	if (swaynag->repeat_timer >= 0) {
+		struct itimerspec disarm = {0};
+		timerfd_settime(swaynag->repeat_timer, 0, &disarm, NULL);
+	}
+}
+
+static void start_repeat(struct swaynag *swaynag, struct swaynag_seat *seat,
+		uint32_t key, xkb_keysym_t sym) {
+	struct swaynag_keyboard *keyboard = &seat->keyboard;
+	if (swaynag->repeat_timer < 0 || keyboard->repeat_rate <= 0) {
+		return;
+	}
+	swaynag->repeat_seat = seat;
+	swaynag->repeat_key = key;
+	swaynag->repeat_sym = sym;
+
+	long interval = 1000000000L / keyboard->repeat_rate;
+	struct itimerspec spec = {
+		.it_interval = {
+			.tv_sec = interval / 1000000000L,
+			.tv_nsec = interval % 1000000000L,
+		},
+	};
+	if (keyboard->repeat_delay > 0) {
+		spec.it_value.tv_sec = keyboard->repeat_delay / 1000;
+		spec.it_value.tv_nsec = (keyboard->repeat_delay % 1000) * 1000000L;
+	} else {
+		spec.it_value = spec.it_interval;
+	}
+	if (timerfd_settime(swaynag->repeat_timer, 0, &spec, NULL) < 0) {
+		sway_log_errno(SWAY_ERROR, "Failed to arm the key repeat timer");
+		swaynag->repeat_seat = NULL;
+	}
+}
+
+static void move_focus(struct swaynag *swaynag, int delta, bool wrap) {
+	// Buttons are laid out from right to left in list order, so moving to
+	// the right means going towards the start of the list
+	int count = swaynag->buttons->length;
+	int focused = swaynag->focused_button - delta;
+	if (wrap) {
+		focused = (focused % count + count) % count;
+	} else if (focused < 0) {
+		focused = 0;
+	} else if (focused >= count) {
+		focused = count - 1;
+	}
+	if (focused != swaynag->focused_button) {
+		swaynag->focused_button = focused;
+		render_frame(swaynag);
+	}
+}
+
+static void scroll_details(struct swaynag *swaynag, xkb_keysym_t sym) {
+	struct swaynag_details *details = &swaynag->details;
+	// Only while the scroll buttons are shown
+	if (!details->visible || details->total_lines == details->visible_lines) {
+		return;
+	}
+
+	int bot = details->total_lines - details->visible_lines;
+	int offset = details->offset;
+	switch (sym) {
+	case XKB_KEY_Up:
+		offset--;
+		break;
+	case XKB_KEY_Down:
+		offset++;
+		break;
+	case XKB_KEY_Prior:
+		offset -= details->visible_lines;
+		break;
+	case XKB_KEY_Next:
+		offset += details->visible_lines;
+		break;
+	case XKB_KEY_Home:
+		offset = 0;
+		break;
+	case XKB_KEY_End:
+		offset = bot;
+		break;
+	}
+	if (offset > bot) {
+		offset = bot;
+	}
+	if (offset < 0) {
+		offset = 0;
+	}
+	if (offset != details->offset) {
+		details->offset = offset;
+		render_frame(swaynag);
+	}
+}
+
+static void handle_keysym(struct swaynag *swaynag, xkb_keysym_t sym) {
+	switch (sym) {
+	case XKB_KEY_Escape:
+		swaynag->run_display = false;
+		break;
+	case XKB_KEY_Return:
+	case XKB_KEY_KP_Enter:
+	case XKB_KEY_space:
+		swaynag_button_execute(swaynag,
+				swaynag->buttons->items[swaynag->focused_button]);
+		break;
+	case XKB_KEY_Tab:
+		move_focus(swaynag, 1, true);
+		break;
+	case XKB_KEY_ISO_Left_Tab:
+		move_focus(swaynag, -1, true);
+		break;
+	case XKB_KEY_Right:
+		move_focus(swaynag, 1, false);
+		break;
+	case XKB_KEY_Left:
+		move_focus(swaynag, -1, false);
+		break;
+	case XKB_KEY_Up:
+	case XKB_KEY_Down:
+	case XKB_KEY_Prior:
+	case XKB_KEY_Next:
+	case XKB_KEY_Home:
+	case XKB_KEY_End:
+		scroll_details(swaynag, sym);
+		break;
+	}
+}
+
+static bool keysym_repeats(xkb_keysym_t sym) {
+	switch (sym) {
+	case XKB_KEY_Tab:
+	case XKB_KEY_ISO_Left_Tab:
+	case XKB_KEY_Right:
+	case XKB_KEY_Left:
+	case XKB_KEY_Up:
+	case XKB_KEY_Down:
+	case XKB_KEY_Prior:
+	case XKB_KEY_Next:
+		return true;
+	default:
+		return false;
+	}
+}
