+#ifndef _SWAY_INPUT_KEYBOARD_LATIN_H
+#define _SWAY_INPUT_KEYBOARD_LATIN_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <xkbcommon/xkbcommon.h>
+
+/**
+ * Key bindings in layouts without Latin letters, as GNOME does it.
+ *
+ * Plain bindsym bindings match the keysyms of the active layout, so in a
+ * Russian or Greek layout no letter binding (Mod4+z, ...) can match. GNOME
+ * (mutter's needs_secondary_layout) then also looks the key up in the US
+ * layout. These helpers provide the same check and lookup.
+ */
+
+/**
+ * Whether the layout lacks one of the letters a-z on its first level.
+ */
+bool keyboard_layout_lacks_latin(struct xkb_keymap *keymap,
+		xkb_layout_index_t layout);
+
+/**
+ * The first-level keysyms the key has in the US layout. The key is found by
+ * name, so this works for any keymap. Returns the number of keysyms.
+ */
+size_t keyboard_latin_keysyms(struct xkb_keymap *keymap,
+		xkb_keycode_t keycode, const xkb_keysym_t **keysyms);
+
+#endif
