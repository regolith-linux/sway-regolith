+/**
+ * Whether bindings should also be matched against the key's US keysyms:
+ * true when the key's current layout lacks Latin letters, as in GNOME.
+ */
+static bool keyboard_use_latin_fallback(struct sway_keyboard *keyboard,
+		xkb_keycode_t keycode) {
+	struct xkb_keymap *keymap = keyboard->wlr->keymap;
+	xkb_layout_index_t layout = xkb_state_key_get_layout(
+		keyboard->wlr->xkb_state, keycode);
+	if (!keymap || layout == XKB_LAYOUT_INVALID) {
+		return false;
+	}
+	if (keyboard->latin_checked_keymap != keymap ||
+			keyboard->latin_checked_layout != layout) {
+		keyboard->latin_checked_keymap = keymap;
+		keyboard->latin_checked_layout = layout;
+		keyboard->latin_fallback =
+			keyboard_layout_lacks_latin(keymap, layout);
+	}
+	return keyboard->latin_fallback;
+}
