Index: sway-regolith/sway/input/keyboard_latin.c
===================================================================
--- /dev/null
+++ sway-regolith/sway/input/keyboard_latin.c
@@ -0,0 +1,59 @@
+#include <stdbool.h>
+#include <xkbcommon/xkbcommon.h>
+#include <xkbcommon/xkbcommon-keysyms.h>
+#include "sway/input/keyboard_latin.h"
+
+bool keyboard_layout_lacks_latin(struct xkb_keymap *keymap,
+		xkb_layout_index_t layout) {
+	bool found[XKB_KEY_z - XKB_KEY_a + 1] = { false };
+	int missing = XKB_KEY_z - XKB_KEY_a + 1;
+	xkb_keycode_t min = xkb_keymap_min_keycode(keymap);
+	xkb_keycode_t max = xkb_keymap_max_keycode(keymap);
+	for (xkb_keycode_t keycode = min; keycode <= max && missing > 0; keycode++) {
+		if (layout >= xkb_keymap_num_layouts_for_key(keymap, keycode)) {
+			continue;
+		}
+		const xkb_keysym_t *syms;
+		int n = xkb_keymap_key_get_syms_by_level(keymap, keycode, layout, 0,
+				&syms);
+		for (int i = 0; i < n; i++) {
+			if (syms[i] >= XKB_KEY_a && syms[i] <= XKB_KEY_z &&
+					!found[syms[i] - XKB_KEY_a]) {
+				found[syms[i] - XKB_KEY_a] = true;
+				missing--;
+			}
+		}
+	}
+	return missing > 0;
+}
+
+static struct xkb_keymap *us_keymap(void) {
+	static struct xkb_keymap *keymap = NULL;
+	static bool tried = false;
+	if (!tried) {
+		tried = true;
+		struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+		if (context) {
+			struct xkb_rule_names names = { .layout = "us" };
+			keymap = xkb_keymap_new_from_names(context, &names,
+					XKB_KEYMAP_COMPILE_NO_FLAGS);
+			xkb_context_unref(context);
+		}
+	}
+	return keymap;
+}
+
+size_t keyboard_latin_keysyms(struct xkb_keymap *keymap,
+		xkb_keycode_t keycode, const xkb_keysym_t **keysyms) {
+	struct xkb_keymap *us = us_keymap();
+	const char *name = xkb_keymap_key_get_name(keymap, keycode);
+	if (!us || !name) {
+		return 0;
+	}
+	xkb_keycode_t us_keycode = xkb_keymap_key_by_name(us, name);
+	if (us_keycode == XKB_KEYCODE_INVALID) {
+		return 0;
+	}
+	int n = xkb_keymap_key_get_syms_by_level(us, us_keycode, 0, 0, keysyms);
+	return n > 0 ? (size_t)n : 0;
+}
