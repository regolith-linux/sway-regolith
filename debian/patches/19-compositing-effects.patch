diff --git a/sway/desktop/effects.c b/sway/desktop/effects.c
new file mode 100644
--- /dev/null
+++ b/sway/desktop/effects.c
@@ -0,0 +1,444 @@
+#include <drm_fourcc.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/box.h>
+#include "sway/config.h"
+#include "sway/desktop/effects.h"
+#include "sway/output.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "sway/tree/view.h"
+#include "sway/tree/workspace.h"
+#include "log.h"
+
+/*
+ * Dimming and shadows are made of scene buffers holding small, CPU-rendered
+ * premultiplied ARGB8888 images, so they look the same with every renderer,
+ * including the software one. They never take pointer input: clicks and
+ * motion go through to whatever lies underneath.
+ */
+
+struct pixel_buffer {
+	struct wlr_buffer base;
+	uint32_t *data;
+	size_t stride;
+};
+
+static void pixel_buffer_handle_destroy(struct wlr_buffer *wlr_buffer) {
+	struct pixel_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	free(buffer->data);
+	free(buffer);
+}
+
+static bool pixel_buffer_handle_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct pixel_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	*data = buffer->data;
+	*format = DRM_FORMAT_ARGB8888;
+	*stride = buffer->stride;
+	return true;
+}
+
+static void pixel_buffer_handle_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	// This space is intentionally left blank
+}
+
+static const struct wlr_buffer_impl pixel_buffer_impl = {
+	.destroy = pixel_buffer_handle_destroy,
+	.begin_data_ptr_access = pixel_buffer_handle_begin_data_ptr_access,
+	.end_data_ptr_access = pixel_buffer_handle_end_data_ptr_access,
+};
+
+static struct pixel_buffer *pixel_buffer_create(int width, int height) {
+	struct pixel_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		return NULL;
+	}
+	buffer->data = calloc((size_t)width * height, sizeof(uint32_t));
+	if (!buffer->data) {
+		free(buffer);
+		return NULL;
+	}
+	buffer->stride = (size_t)width * sizeof(uint32_t);
+	wlr_buffer_init(&buffer->base, &pixel_buffer_impl, width, height);
+	return buffer;
+}
+
+static uint8_t to_byte(float value) {
+	value = value < 0.0f ? 0.0f : value > 1.0f ? 1.0f : value;
+	return (uint8_t)lroundf(value * 255.0f);
+}
+
+// color is straight RGB; alpha is the coverage the pixel gets
+static uint32_t premultiplied_pixel(const float color[static 3], float alpha) {
+	uint8_t a = to_byte(alpha);
+	uint8_t r = to_byte(color[0] * alpha);
+	uint8_t g = to_byte(color[1] * alpha);
+	uint8_t b = to_byte(color[2] * alpha);
+	return (uint32_t)a << 24 | (uint32_t)r << 16 | (uint32_t)g << 8 | b;
+}
+
+static bool effect_point_accepts_input(struct wlr_scene_buffer *buffer,
+		double *x, double *y) {
+	return false;
+}
+
+static struct wlr_scene_buffer *effect_buffer_create(struct wlr_scene_tree *parent) {
+	struct wlr_scene_buffer *buffer = wlr_scene_buffer_create(parent, NULL);
+	if (buffer) {
+		buffer->point_accepts_input = effect_point_accepts_input;
+	}
+	return buffer;
+}
+
+bool container_effects_create(struct sway_container *con) {
+	con->dim_node = effect_buffer_create(con->scene_tree);
+	if (!con->dim_node) {
+		return false;
+	}
+	wlr_scene_node_set_enabled(&con->dim_node->node, false);
+
+	con->shadow.tree = wlr_scene_tree_create(root->staging);
+	if (!con->shadow.tree) {
+		return false;
+	}
+	wlr_scene_node_set_enabled(&con->shadow.tree->node, false);
+	for (size_t i = 0; i < sizeof(con->shadow.pieces) / sizeof(con->shadow.pieces[0]); i++) {
+		con->shadow.pieces[i] = effect_buffer_create(con->shadow.tree);
+		if (!con->shadow.pieces[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void container_effects_destroy(struct sway_container *con) {
+	if (con->dim_node) {
+		wlr_scene_node_destroy(&con->dim_node->node);
+		con->dim_node = NULL;
+	}
+	if (con->shadow.tree) {
+		wlr_scene_node_destroy(&con->shadow.tree->node);
+		con->shadow.tree = NULL;
+	}
+}
+
+/* Dimming */
+
+void container_update_dim(struct sway_container *con) {
+	if (!con->dim_node) {
+		return;
+	}
+
+	float amount = con->dim_inactive >= 0.0f ?
+		con->dim_inactive : config->default_dim_inactive;
+	const float *color = view_is_urgent(con->view) ?
+		config->dim_inactive_colors.urgent : config->dim_inactive_colors.unfocused;
+	float alpha = amount * color[3];
+
+	if (alpha <= 0.0f || con->dim_width <= 0 || con->dim_height <= 0 ||
+			!container_is_current_unfocused(con)) {
+		wlr_scene_node_set_enabled(&con->dim_node->node, false);
+		return;
+	}
+
+	uint32_t pixel = premultiplied_pixel(color, alpha);
+	if (!con->dim_node->buffer || pixel != con->dim_pixel) {
+		// A 3x3 image sampled at its centre pixel and stretched over the
+		// box: every filter only ever reads identical neighbours, so the
+		// colour stays uniform up to the edges.
+		struct pixel_buffer *buffer = pixel_buffer_create(3, 3);
+		if (!buffer) {
+			sway_log(SWAY_ERROR, "Failed to allocate the dim buffer");
+			wlr_scene_node_set_enabled(&con->dim_node->node, false);
+			return;
+		}
+		for (int i = 0; i < 9; i++) {
+			buffer->data[i] = pixel;
+		}
+		wlr_scene_buffer_set_buffer(con->dim_node, &buffer->base);
+		wlr_buffer_drop(&buffer->base);
+		wlr_scene_buffer_set_source_box(con->dim_node,
+			&(struct wlr_fbox){ .x = 1, .y = 1, .width = 1, .height = 1 });
+		con->dim_pixel = pixel;
+	}
+	wlr_scene_node_set_enabled(&con->dim_node->node, true);
+}
+
+void container_arrange_dim(struct sway_container *con,
+		struct wlr_scene_tree *parent, const struct wlr_box *box) {
+	if (!con->dim_node) {
+		return;
+	}
+
+	wlr_scene_node_reparent(&con->dim_node->node, parent);
+	wlr_scene_node_raise_to_top(&con->dim_node->node);
+	wlr_scene_node_set_position(&con->dim_node->node, box->x, box->y);
+	con->dim_width = box->width;
+	con->dim_height = box->height;
+	if (box->width > 0 && box->height > 0) {
+		wlr_scene_buffer_set_dest_size(con->dim_node, box->width, box->height);
+	}
+	container_update_dim(con);
+}
+
+/* Shadows */
+
+enum shadow_segment {
+	SHADOW_BEFORE,
+	SHADOW_ALONG,
+	SHADOW_AFTER,
+};
+
+// Distance in logical pixels from the centre of template pixel i to the
+// template's middle section, along one axis.
+static double shadow_template_distance(int i, int corner, int center, float scale) {
+	if (i < corner) {
+		return (corner - i - 0.5) / scale;
+	} else if (i < corner + center) {
+		return 0.0;
+	}
+	return (i - corner - center + 0.5) / scale;
+}
+
+static float shadow_coverage(double distance, int radius, float alpha) {
+	if (radius == 0) {
+		return distance == 0.0 ? alpha : 0.0f;
+	}
+	if (distance >= radius) {
+		return 0.0f;
+	}
+	double falloff = 1.0 - distance / radius;
+	return alpha * falloff * falloff;
+}
+
+/**
+ * The shadow of a box is cut into nine pieces of one template image: four
+ * corners and four edges at their natural size around a uniform middle. The
+ * edge and middle pieces stretch a single pixel taken from the middle of the
+ * template, so the image stays small whatever the size of the window.
+ */
+static bool shadow_render_template(struct sway_container *con, int radius,
+		float scale, const float color[static 4]) {
+	int corner = (int)lround(radius * scale);
+	int center = (int)ceilf(3.0f * scale);
+	if (center < 3) {
+		center = 3;
+	}
+	int size = 2 * corner + center;
+
+	struct pixel_buffer *buffer = pixel_buffer_create(size, size);
+	if (!buffer) {
+		sway_log(SWAY_ERROR, "Failed to allocate the shadow buffer");
+		return false;
+	}
+
+	double *distance = calloc(size, sizeof(double));
+	if (!distance) {
+		wlr_buffer_drop(&buffer->base);
+		return false;
+	}
+	for (int i = 0; i < size; i++) {
+		distance[i] = shadow_template_distance(i, corner, center, scale);
+	}
+
+	for (int y = 0; y < size; y++) {
+		uint32_t *row = buffer->data + (size_t)y * size;
+		for (int x = 0; x < size; x++) {
+			double d = distance[x] == 0.0 ? distance[y] :
+				distance[y] == 0.0 ? distance[x] : hypot(distance[x], distance[y]);
+			float coverage = shadow_coverage(d, radius, color[3]);
+			row[x] = coverage > 0.0f ? premultiplied_pixel(color, coverage) : 0;
+		}
+	}
+	free(distance);
+
+	for (size_t i = 0; i < sizeof(con->shadow.pieces) / sizeof(con->shadow.pieces[0]); i++) {
+		wlr_scene_buffer_set_buffer(con->shadow.pieces[i], &buffer->base);
+	}
+	wlr_buffer_drop(&buffer->base);
+
+	con->shadow.radius = radius;
+	con->shadow.scale = scale;
+	memcpy(con->shadow.color, color, sizeof(con->shadow.color));
+	con->shadow.corner = corner;
+	con->shadow.center = center;
+	con->shadow.rendered = true;
+	return true;
+}
+
+/**
+ * One axis of a piece: the logical interval it covers, clipped to [clip_start,
+ * clip_end), and the template interval it is taken from. Returns false when
+ * nothing of the piece is left on this axis.
+ */
+static bool shadow_piece_axis(enum shadow_segment segment, int start, int length,
+		int radius, int corner, int center, int clip_start, int clip_end,
+		int *dst_start, int *dst_length, double *src_start, double *src_length) {
+	int seg_start, seg_length;
+	switch (segment) {
+	case SHADOW_BEFORE:
+		seg_start = start - radius;
+		seg_length = radius;
+		*src_start = 0;
+		*src_length = corner;
+		break;
+	case SHADOW_ALONG:
+		seg_start = start;
+		seg_length = length;
+		*src_start = corner + center / 2;
+		*src_length = 1;
+		break;
+	case SHADOW_AFTER:
+	default:
+		seg_start = start + length;
+		seg_length = radius;
+		*src_start = corner + center;
+		*src_length = corner;
+		break;
+	}
+
+	int clipped_start = seg_start > clip_start ? seg_start : clip_start;
+	int seg_end = seg_start + seg_length;
+	int clipped_end = seg_end < clip_end ? seg_end : clip_end;
+	if (seg_length <= 0 || clipped_end <= clipped_start) {
+		return false;
+	}
+
+	if (segment != SHADOW_ALONG) {
+		// Corner and edge depths map one to one onto the template; the
+		// stretched middle is uniform, so it needs no adjustment.
+		double ratio = *src_length / seg_length;
+		*src_start += (clipped_start - seg_start) * ratio;
+		*src_length = (clipped_end - clipped_start) * ratio;
+	}
+	*dst_start = clipped_start;
+	*dst_length = clipped_end - clipped_start;
+	return true;
+}
+
+// Park the shadow in the staging tree, so that it never goes away with the
+// tree it was last placed in.
+static void shadow_disable(struct sway_container *con) {
+	wlr_scene_node_set_enabled(&con->shadow.tree->node, false);
+	wlr_scene_node_reparent(&con->shadow.tree->node, root->staging);
+}
+
+void container_disable_shadows(struct sway_container *con) {
+	if (con->shadow.tree) {
+		shadow_disable(con);
+	}
+	if (!con->view && con->current.children) {
+		for (int i = 0; i < con->current.children->length; i++) {
+			container_disable_shadows(con->current.children->items[i]);
+		}
+	}
+}
+
+/**
+ * Whether the window has agreed through xdg-decoration to draw its own
+ * decorations. Sway sends the client-side mode exactly when it gives such a
+ * window the csd border, so the border settles the agreement. Windows that
+ * negotiate nothing are only assumed to decorate themselves (sway refuses
+ * "border csd" for them), and are treated like any other window.
+ */
+static bool container_draws_own_decorations(struct sway_container *con) {
+	return con->current.border == B_CSD && con->view->xdg_decoration;
+}
+
+void container_arrange_shadow(struct sway_container *con,
+		struct wlr_scene_tree *layer, const struct wlr_box *box) {
+	if (!con->shadow.tree) {
+		return;
+	}
+
+	struct sway_workspace *ws = con->current.workspace;
+	struct sway_output *output = ws ? ws->output : NULL;
+	const float *color = container_is_current_unfocused(con) ?
+		config->shadow_inactive_color : config->shadow_color;
+	int width = box->width, height = box->height;
+
+	if (!layer || !output || !output->wlr_output->enabled ||
+			!config->shadow_enabled || color[3] <= 0.0f ||
+			width <= 0 || height <= 0 ||
+			(!config->shadows_on_csd_enabled &&
+				container_draws_own_decorations(con))) {
+		shadow_disable(con);
+		return;
+	}
+
+	int radius = config->shadow_blur_radius;
+	float scale = output->wlr_output->scale;
+	if (!con->shadow.rendered || con->shadow.radius != radius ||
+			con->shadow.scale != scale ||
+			memcmp(con->shadow.color, color, sizeof(con->shadow.color)) != 0) {
+		if (!shadow_render_template(con, radius, scale, color)) {
+			shadow_disable(con);
+			return;
+		}
+	}
+
+	// The shadow tree's origin is the layout origin, so the pieces are
+	// positioned in layout coordinates.
+	wlr_scene_node_reparent(&con->shadow.tree->node, layer);
+	int layer_x, layer_y;
+	wlr_scene_node_coords(&layer->node, &layer_x, &layer_y);
+	wlr_scene_node_set_position(&con->shadow.tree->node, -layer_x, -layer_y);
+
+	int box_x, box_y;
+	wlr_scene_node_coords(&con->scene_tree->node, &box_x, &box_y);
+	box_x += box->x;
+	box_y += box->y;
+	// Offsets this large move any shadow off every output anyway; clamping
+	// keeps the layout arithmetic within range.
+	const int max_offset = 1 << 20;
+	int offset_x = config->shadow_offset_x < -max_offset ? -max_offset :
+		config->shadow_offset_x > max_offset ? max_offset : config->shadow_offset_x;
+	int offset_y = config->shadow_offset_y < -max_offset ? -max_offset :
+		config->shadow_offset_y > max_offset ? max_offset : config->shadow_offset_y;
+	int shadow_x = box_x + offset_x;
+	int shadow_y = box_y + offset_y;
+
+	// A shadow belongs to the output its window's workspace is on
+	struct wlr_box clip = {
+		.x = output->lx,
+		.y = output->ly,
+		.width = output->width,
+		.height = output->height,
+	};
+
+	static const enum shadow_segment segments[] = {
+		SHADOW_BEFORE, SHADOW_ALONG, SHADOW_AFTER,
+	};
+	for (int row = 0; row < 3; row++) {
+		for (int col = 0; col < 3; col++) {
+			struct wlr_scene_buffer *piece = con->shadow.pieces[row * 3 + col];
+			int dst_x, dst_y, dst_width, dst_height;
+			struct wlr_fbox src;
+			bool visible =
+				shadow_piece_axis(segments[col], shadow_x, width, radius,
+					con->shadow.corner, con->shadow.center,
+					clip.x, clip.x + clip.width,
+					&dst_x, &dst_width, &src.x, &src.width) &&
+				shadow_piece_axis(segments[row], shadow_y, height, radius,
+					con->shadow.corner, con->shadow.center,
+					clip.y, clip.y + clip.height,
+					&dst_y, &dst_height, &src.y, &src.height);
+			wlr_scene_node_set_enabled(&piece->node, visible);
+			if (!visible) {
+				continue;
+			}
+			wlr_scene_buffer_set_source_box(piece, &src);
+			wlr_scene_buffer_set_dest_size(piece, dst_width, dst_height);
+			wlr_scene_node_set_position(&piece->node, dst_x, dst_y);
+		}
+	}
+
+	wlr_scene_node_set_enabled(&con->shadow.tree->node, true);
+}
