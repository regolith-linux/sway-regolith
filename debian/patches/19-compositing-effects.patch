+#ifndef _SWAY_DESKTOP_EFFECTS_H
+#define _SWAY_DESKTOP_EFFECTS_H
+#include <stdbool.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/box.h>
+
+struct sway_container;
+
+/**
+ * Allocate the scene nodes a view container uses to dim itself and to cast a
+ * drop shadow. The dim node is created inside the container's scene tree; the
+ * shadow tree starts out in the staging tree and is placed by the arrange code.
+ */
+bool container_effects_create(struct sway_container *con);
+
+/**
+ * Destroy the dim node and the shadow tree wherever they are currently placed.
+ */
+void container_effects_destroy(struct sway_container *con);
+
+/**
+ * Place the dim node on top of parent, covering box (relative to the origin of
+ * parent), then refresh it.
+ */
+void container_arrange_dim(struct sway_container *con,
+		struct wlr_scene_tree *parent, const struct wlr_box *box);
+
+/**
+ * Refresh the dim node's colour and visibility from the container's current
+ * focus and urgency state and the dimming configuration.
+ */
+void container_update_dim(struct sway_container *con);
+
+/**
+ * Place the container's shadow in layer, cast by box (relative to the origin
+ * of the container's scene tree). A NULL layer means that the container casts
+ * no shadow in its current position.
+ */
+void container_arrange_shadow(struct sway_container *con,
+		struct wlr_scene_tree *layer, const struct wlr_box *box);
+
+/**
+ * Hide the shadows of a container and all its descendants.
+ */
+void container_disable_shadows(struct sway_container *con);
+
+#endif
