+/**
+ * The commands of a rule only run once a matching window appears. Settings
+ * whose arguments can be checked without a window are checked here already,
+ * so that a rule which could never apply makes the configuration fail.
+ */
+static struct cmd_results *check_cmdlist(const char *cmdlist) {
+	char *copy = strdup(cmdlist);
+	if (!copy) {
+		return NULL;
+	}
+
+	struct cmd_results *error = NULL;
+	char *head = copy;
+	char matched_delim = ';';
+	do {
+		for (; isspace(*head); ++head) {}
+		if (matched_delim == ';' && *head == '[') {
+			char *criteria_error = NULL;
+			struct criteria *criteria = criteria_parse(head, &criteria_error);
+			if (!criteria) {
+				// reported when the rule runs, as before
+				free(criteria_error);
+				break;
+			}
+			head += strlen(criteria->raw);
+			criteria_destroy(criteria);
+		}
+
+		char *cmd = argsep(&head, ";,", &matched_delim);
+		for (; isspace(*cmd); ++cmd) {}
+		if (*cmd == '\0') {
+			continue;
+		}
+
+		int cmd_argc;
+		char **cmd_argv = split_args(cmd, &cmd_argc);
+		if (cmd_argc > 0 && strcasecmp(cmd_argv[0], "dim_inactive") == 0) {
+			// A variable still in the rule may be set later in the
+			// configuration; it is expanded when the rule runs.
+			bool has_variable = false;
+			for (int i = 1; i < cmd_argc; ++i) {
+				if (*cmd_argv[i] == '\"' || *cmd_argv[i] == '\'') {
+					strip_quotes(cmd_argv[i]);
+				}
+				has_variable = has_variable || strchr(cmd_argv[i], '$');
+			}
+			float amount;
+			if (!has_variable) {
+				error = dim_inactive_parse("dim_inactive",
+					cmd_argc - 1, cmd_argv + 1, &amount);
+			}
+		}
+		free_argv(cmd_argc, cmd_argv);
+	} while (head && !error);
+
+	free(copy);
+	return error;
+}
