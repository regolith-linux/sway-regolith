diff --git a/sway/commands/dim_inactive.c b/sway/commands/dim_inactive.c
new file mode 100644
--- /dev/null
+++ b/sway/commands/dim_inactive.c
@@ -0,0 +1,66 @@
+#include <math.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "sway/tree/node.h"
+#include "util.h"
+
+struct cmd_results *dim_inactive_parse(const char *name, int argc, char **argv,
+		float *value) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, name, EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+
+	float amount = argv[0][0] ? parse_float(argv[0]) : NAN;
+	// NAN fails both comparisons
+	if (!(amount >= 0.0f && amount <= 1.0f)) {
+		return cmd_results_new(CMD_INVALID,
+			"Invalid %s value '%s' (expected a number from 0 to 1)",
+			name, argv[0]);
+	}
+
+	*value = amount;
+	return NULL;
+}
+
+struct cmd_results *cmd_default_dim_inactive(int argc, char **argv) {
+	float amount;
+	struct cmd_results *error =
+		dim_inactive_parse("default_dim_inactive", argc, argv, &amount);
+	if (error) {
+		return error;
+	}
+
+	config->default_dim_inactive = amount;
+
+	if (config->active) {
+		arrange_root();
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_dim_inactive(int argc, char **argv) {
+	float amount;
+	struct cmd_results *error =
+		dim_inactive_parse("dim_inactive", argc, argv, &amount);
+	if (error) {
+		return error;
+	}
+
+	struct sway_container *con = config->handler_context.container;
+	if (!con) {
+		return cmd_results_new(CMD_FAILURE, "No current container");
+	}
+	if (!con->view) {
+		return cmd_results_new(CMD_INVALID,
+			"dim_inactive can only be set for windows");
+	}
+
+	con->dim_inactive = amount;
+	node_set_dirty(&con->node);
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
